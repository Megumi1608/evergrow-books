{
  "name": "evergrow-books",
  "productName": "Evergrow Books",
  "version": "1.13.0",
  "private": true,
  "description": "Sổ thu chi doanh nghiệp — dữ liệu SQLite cục bộ",
  "main": "dist-electron/main.cjs",
  "author": "Evergrow",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Megumi1608/evergrow-books.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && node scripts/verify.mjs",
    "icon": "python scripts/make-icon.py",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "lucide-animated": "^1.0.5",
    "motion": "^14.12.0"
